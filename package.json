{
  "name": "synbio-llvm",
  "version": "0.1.0",
  "description": "Compilador de Sistemas Genéticos Dinámicos - IDE para biología sintética",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "watch": "cd client && npm run watch",
    "lint": "cd client && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synbio-llvm/synbio-llvm"
  },
  "keywords": [
    "synthetic-biology",
    "compiler",
    "genetic-circuits",
    "bioinformatics",
    "llvm",
    "vscode-extension"
  ],
  "author": "SynBio-LLVM Team",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  }
}
