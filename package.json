{
  "name": "synbio-llvm",
  "version": "1.0.1",
  "description": "BioScript compiler, language server, and local simulation engine for genetic circuit design",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build": "npm run build:client",
    "build:client": "cd client && npm run build",
    "watch": "cd client && npm run watch",
    "lint": "cd client && npm run lint",
    "test": "npm run test:client && npm run test:rust && npm run test:python",
    "test:client": "npm test --workspace client",
    "test:rust": "cargo test --manifest-path server/Cargo.toml",
    "test:python": "python3 -m pytest python-engine"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jorgegn29/Synbio-studio"
  },
  "keywords": [
    "synthetic-biology",
    "compiler",
    "genetic-circuits",
    "bioinformatics",
    "llvm",
    "vscode-extension"
  ],
  "author": "Jorge Guillem Najarro",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18.0.0"
  }
}
