// Elowitz & Leibler (2000) repressilator: a three-repressor ring.
// lambda PR (pLambda) drives lacI, pLac drives tetR, pTet drives cI.
// LacI represses pLac, TetR represses pTet, and cI represses pLambda.
// The ~> lines are repression, not DNA order.

circuit Repressilator {
    pLambda -> B0034 -> LacI -> B0015
    pLac -> B0034 -> TetR -> B0015
    pTet -> B0034 -> cI -> B0015
    LacI ~> pLac
    TetR ~> pTet
    cI ~> pLambda
}
