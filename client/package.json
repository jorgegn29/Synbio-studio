{
  "name": "synbio-llvm-client",
  "displayName": "SynBio-LLVM",
  "description": "Compilador de circuitos genéticos para VS Code",
  "version": "0.2.0",
  "publisher": "synbio-llvm",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run build -- --watch",
    "lint": "eslint src --ext .ts",
    "test": "mocha -r ts-node/register 'src/test/**/*.test.ts'",
    "test:ci": "c8 --reporter=text --reporter=lcov mocha -r ts-node/register 'src/test/**/*.test.ts'"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "c8": "^10.1.3",
    "chai": "^6.2.2",
    "esbuild": "^0.19.8",
    "eslint": "^8.54.0",
    "glob": "^7.2.3",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2"
  }
}
